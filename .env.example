# Environment Configuration for LegalReasonerX Web Application

# CourtListener API (Required)
# Get your free API token at: https://www.courtlistener.com/sign-in/
COURTLISTENER_API_TOKEN=your_courtlistener_token_here

# OpenAI API (Optional - only needed for AI Reasoning features)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
